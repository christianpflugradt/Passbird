{
  "branches": ["main"],
  "repositoryUrl": "https://github.com/christianpflugradt/Passbird.git",
  "tagFormat": "${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "releaseRules": [
          { "type": "major",   "release": "major" },
          { "type": "feat",    "release": "minor" },
          { "type": "fix",     "release": "patch" },
          { "type": "build",   "release": "patch" },
          { "type": "chore",   "release": "patch" },
          { "type": "perf",    "release": "patch" },
          { "type": "refactor","release": "patch" },
          { "type": "revert",  "release": "patch" },
          { "type": "test",    "release": "patch" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "major",   "section": ":rotating_light: Breaking Changes",   "hidden": false },
            { "type": "feat",    "section": ":bulb: Features",                     "hidden": false },
            { "type": "fix",     "section": ":beetle: Bug Fixes",                  "hidden": false },
            { "type": "build",   "section": ":package: Build Adjustments",         "hidden": false },
            { "type": "chore",   "section": ":hammer: Maintenance & Dependencies", "hidden": false },
            { "type": "perf",    "section": ":rocket: Performance Improvements",   "hidden": false },
            { "type": "refactor","section": ":gear: Refactoring",                  "hidden": false },
            { "type": "revert",  "section": ":leftwards_arrow_with_hook: Revert",  "hidden": false },
            { "type": "test",    "section": ":unicorn: Quality Assurance",         "hidden": false }
          ]
        }
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./gradlew -PcreatedBy=\"GitHub Actions\" -PreleaseVersion=${nextRelease.version} jar && .github/scripts/verify-release-jar-manifest.sh build/libs/passbird.jar ${nextRelease.version} && .github/scripts/verify-release-jar-payload.sh verified-release-jar/passbird.jar build/libs/passbird.jar"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "build/libs/passbird.jar",
            "name": "passbird.jar",
            "label": "Passbird executable JAR"
          }
        ],
        "successComment": false,
        "failComment": false,
        "releasedLabels": false,
        "addReleases": false
      }
    ]
  ]
}
