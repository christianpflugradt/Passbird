{
    "description": [
        "Standard dependency updates wait 7 days before Renovate creates branches or PRs.",
        "GitHub Actions and major-version updates wait 14 days."
    ],
    "dependencyDashboard": {
        "enabled": true,
        "osvVulnerabilitySummary": "all"
    },
    "minimumReleaseAge": "7 days",
    "minimumReleaseAgeBehaviour": "timestamp-required",
    "internalChecksFilter": "strict",
    "separateMultipleMajor": true,
    "prCreation": "immediate",
    "automerge": false,
    "platformAutomerge": false,
    "rebaseWhen": "behind-base-branch",
    "packageRules": [
        {
            "description": [
                "Non-major GitHub Actions updates are grouped and use a 14-day cooldown."
            ],
            "matchFileNames": [
                ".github/**"
            ],
            "matchUpdateTypes": [
                "patch",
                "minor",
                "digest"
            ],
            "groupName": "github-actions",
            "minimumReleaseAge": "14 days",
            "matchPackageNames": [
                "!please-behave/action"
            ]
        },
        {
            "description": [
                "Patch, minor, and digest dependency updates auto-merge after green CI."
            ],
            "matchUpdateTypes": [
                "patch",
                "minor",
                "digest"
            ],
            "automerge": true
        },
        {
            "description": [
                "Major-version updates, including GitHub Actions, stay manual."
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "minimumReleaseAge": "14 days",
            "matchPackageNames": [
                "!please-behave/cli",
                "!please-behave/action"
            ]
        },
        {
            "matchPackageNames": [
                "eclipse-temurin"
            ],
            "allowedVersions": "/^(21|25)-jdk/"
        },
        {
            "description": [
                "Gradle-related updates refresh dependency verification metadata before Renovate commits the branch."
            ],
            "matchManagers": [
                "gradle",
                "gradle-wrapper",
                "custom.regex"
            ],
            "postUpgradeTasks": {
                "commands": [
                    "./gradlew --write-verification-metadata sha256,pgp --export-keys compileKotlin compileTestKotlin compileJava compileTestJava"
                ],
                "fileFilters": [
                    "gradle/verification-metadata.xml",
                    "gradle/verification-keyring.keys"
                ],
                "executionMode": "branch"
            },
            "matchPackageNames": [
                "!please-behave/cli"
            ]
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^build.gradle.kts$/"
            ],
            "matchStrings": [
                "ktlint\\.version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
            ],
            "depNameTemplate": "pinterest/ktlint",
            "datasourceTemplate": "github-releases"
        }
    ],
    "extends": [
        "github>christianpflugradt/please-behave-governance:renovate-governor",
        "github>christianpflugradt/please-behave-governance:renovate-content-aware",
        ":maintainLockFilesMonthly"
    ]
}
