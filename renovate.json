{
    "description": [
        "Standard dependency updates wait 7 days before Renovate creates branches or PRs.",
        "GitHub Actions and major-version updates wait 14 days."
    ],
    "dependencyDashboard": true,
    "dependencyDashboardOSVVulnerabilitySummary": "all",
    "minimumReleaseAge": "7 days",
    "minimumReleaseAgeBehaviour": "timestamp-required",
    "internalChecksFilter": "strict",
    "separateMultipleMajor": true,
    "prCreation": "status-success",
    "automerge": false,
    "platformAutomerge": false,
    "rebaseWhen": "behind-base-branch",
    "packageRules": [
        {
            "description": [
                "GitHub Actions updates use a 14-day cooldown while preserving grouped PRs."
            ],
            "matchFileNames": [
                ".github/**"
            ],
            "groupName": "github-actions",
            "separateMajorMinor": false,
            "minimumReleaseAge": "14 days",
            "automerge": true
        },
        {
            "description": [
                "Patch, minor, and digest dependency updates auto-merge after green CI."
            ],
            "matchUpdateTypes": [
                "patch",
                "minor",
                "digest"
            ],
            "automerge": true
        },
        {
            "description": [
                "Major-version updates stay manual unless another more specific rule enables automerge."
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "minimumReleaseAge": "14 days"
        },
        {
            "matchPackageNames": [
                "eclipse-temurin"
            ],
            "allowedVersions": "/^(21|25)-jdk/"
        },
        {
            "description": [
                "Gradle-related updates refresh dependency verification metadata before Renovate commits the branch."
            ],
            "matchManagers": [
                "gradle",
                "gradle-wrapper",
                "custom.regex"
            ],
            "postUpgradeTasks": {
                "commands": [
                    "./gradlew --write-verification-metadata sha256,pgp --export-keys compileKotlin compileTestKotlin compileJava compileTestJava"
                ],
                "fileFilters": [
                    "gradle/verification-metadata.xml",
                    "gradle/verification-keyring.keys"
                ],
                "executionMode": "branch"
            }
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^build.gradle.kts$/"
            ],
            "matchStrings": [
                "ktlint\\.version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
            ],
            "depNameTemplate": "pinterest/ktlint",
            "datasourceTemplate": "github-releases"
        }
    ]
}
